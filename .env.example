# رابط مشروع Supabase (من Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# المفتاح العام (Anon Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# مفتاح الإدارة السري (Service Role Key - يُستخدم في السيرفر فقط، لا تشاركه أبداً)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# رابط الموقع (للتطوير المحلي اتركه هكذا، وعند النشر ضع دومين الموقع)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# الحد الأقصى لحجم الملف بالميجابايت (الافتراضي 50 MB)
MAX_UPLOAD_MB=50

# إرسال إشعارات المحاضرات عبر حساب Gmail مجاناً (باستخدام App Password من حساب كوكل)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
